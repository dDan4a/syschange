# Maintainer: dDan4a <danshtal at gmail dot com>
pkgname=syschange
pkgver=0.3.1
pkgrel=1
pkgdesc="A history of changes to your setup: config files, packages and services, with diff and undo"
arch=('x86_64' 'aarch64')
url="https://github.com/dDan4a/syschange"
license=('MIT')
depends=('glibc' 'git' 'jq' 'procps-ng')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('893b70fda43e564bde28710d24bc5918243adb70b09bed85320c3a6f5cd47913')

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  go build -o syschange .
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 syschange "$pkgdir/usr/bin/syschange"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
