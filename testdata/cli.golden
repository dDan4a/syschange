{"initialized":true,"count":3,"pending":[{"key":"hypr","title":"Hyprland","changes":[{"id":"hypr/bindings.conf","kind":"config","op":"modified","name":"hypr/bindings.conf","label":"Key bindings","added":1,"removed":1}]},{"key":"kitty","title":"Kitty","changes":[{"id":"kitty/kitty.conf","kind":"config","op":"added","name":"kitty/kitty.conf","label":"kitty.conf","added":1}]},{"key":"waybar","title":"Waybar","changes":[{"id":"waybar/config","kind":"config","op":"added","name":"waybar/config","label":"config","added":1}]}],"history":null,"configDir":"<tmp>/001/config","agents":[],"checkpoints":[],"autoExport":"","version":"0.3.1","oldestPending":"<time>"}

